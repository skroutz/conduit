PHABRICATOR_URL=https://phabricator.example.com/api/
PHABRICATOR_OAUTH_CLIENT_ID=PHID-OASC-12345
PHABRICATOR_OAUTH_CLIENT_SECRET=secret
PHABRICATOR_MCP_SERVER_URL=http://localhost:8000
# Largest file pha_file_prepare_upload accepts, in MiB (default: 16).
# PHABRICATOR_MCP_MAX_UPLOAD_MB=16
# View policy uploaded files are created with (default: no-one, author only).
# PHABRICATOR_MCP_UPLOAD_VIEW_POLICY=no-one
PHABRICATOR_OAUTH_SCOPE=maniphest file phriction
FASTMCP_HOME=/tmp/fastmcp
# SSL_CERT_FILE=/etc/ssl/certs/corporate-ca.pem